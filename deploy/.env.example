# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO DOCKER COMPOSE (BUỔI 7 & BUỔI 8)
# Sao chép file này thành .env trong thư mục deploy/ nếu muốn tùy chỉnh thông số
# =============================================================================

# 1. PostgreSQL 16 (5 Schemas: biometrics, attendance, occupancy, security, reporting)
POSTGRES_DB=smartoffice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# 2. Object Storage (MinIO Local hoặc Cloudflare R2 Production)
OBJECT_STORAGE_PROVIDER=MinIO
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=smartoffice-media
OBJECT_STORAGE_USE_REMOTE_PUT=true

# 3. Cảnh báo Telegram Bot (Tùy chọn cho Module 4 - Security Night Guard)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

